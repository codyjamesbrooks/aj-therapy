<div class="form col-8 col-12-xsmall" id="contact-form">
  <form method="post" action="https://formspree.io/f/mkgrgyno">
    <div class="input-group">
      <input type="text" name="name" id="name" value="" placeholder="Your Name" />
    </div>
    <div class="input-group">
      <input type="email" name="email" id="email" value="" placeholder="Your Email" />
    </div>
    <div class="input-group">
      <input type="text" name="subject" id="subject" value="" placeholder="Subject" />
    </div>
    <div class="input-group">
      <textarea name="message" id="message" placeholder="Enter your message" rows="6"></textarea>
    </div>
    <%#
      OOO message - edit dates when anna is on vacation
      <div>
        <p>
          <span style="color:#ed4933">Please note</span>
          I am on vacation until April 6. I will respond to your message upon my return.
        </p>
      </div>
    %>
    <div class="input-group">
      <input type="submit" value="Send Message" class="primary" />
    </div>
  </form>
</div>